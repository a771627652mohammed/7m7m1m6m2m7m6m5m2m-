<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام المشتريات والمبيعات الذكي</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background: #f0f4f8;
            padding: 20px;
        }
        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }
        h1 {
            color: #1a365d;
            border-right: 5px solid #2b6cb0;
            padding-right: 15px;
            margin-bottom: 25px;
            font-size: 28px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 15px;
            text-align: center;
        }
        .stat-card.green {
            background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
        }
        .stat-card.orange {
            background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%);
        }
        .stat-card.blue {
            background: linear-gradient(135deg, #4299e1 0%, #2b6cb0 100%);
        }
        .stat-card h3 {
            font-size: 14px;
            opacity: 0.9;
            margin-bottom: 8px;
        }
        .stat-card .number {
            font-size: 28px;
            font-weight: bold;
        }
        .table-responsive {
            overflow-x: auto;
            margin: 20px 0;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }
        th {
            background: #2d3748;
            color: white;
            padding: 14px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
        }
        td {
            padding: 12px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }
        tr:hover {
            background: #f7fafc;
        }
        .badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }
        .badge-paid {
            background: #c6f6d5;
            color: #22543d;
        }
        .badge-partial {
            background: #fefcbf;
            color: #744210;
        }
        .badge-unpaid {
            background: #fed7d7;
            color: #742a2a;
        }
        .total-row {
            background: #edf2f7 !important;
            font-weight: bold;
        }
        .total-row td {
            border-top: 3px solid #2d3748;
            padding: 15px 12px;
        }
        .form-section {
            background: #f7fafc;
            padding: 20px;
            border-radius: 12px;
            margin: 25px 0;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            align-items: end;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .form-group label {
            font-weight: 600;
            color: #2d3748;
            font-size: 13px;
        }
        .form-group input, .form-group select {
            padding: 10px 12px;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            font-size: 14px;
            transition: 0.3s;
        }
        .form-group input:focus, .form-group select:focus {
            outline: none;
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
        }
        .btn {
            padding: 10px 25px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            font-size: 14px;
        }
        .btn-primary {
            background: #4299e1;
            color: white;
        }
        .btn-primary:hover {
            background: #2b6cb0;
            transform: translateY(-2px);
        }
        .btn-success {
            background: #48bb78;
            color: white;
        }
        .btn-success:hover {
            background: #38a169;
            transform: translateY(-2px);
        }
        .btn-danger {
            background: #fc8181;
            color: white;
        }
        .btn-danger:hover {
            background: #e53e3e;
            transform: translateY(-2px);
        }
        .action-btn {
            padding: 5px 12px;
            font-size: 12px;
            margin: 0 3px;
            border-radius: 6px;
        }
        .summary-row {
            background: #ebf8ff;
            font-weight: 600;
        }
        .summary-row td {
            border-top: 2px solid #4299e1;
        }
        .footer {
            margin-top: 30px;
            text-align: center;
            color: #718096;
            font-size: 13px;
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
        }
        @media (max-width: 600px) {
            .container { padding: 15px; }
            .stats-grid { grid-template-columns: 1fr 1fr; }
            .form-section { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<div class="container">
    <h1>📊 نظام المشتريات والمبيعات الذكي</h1>
    
    <!-- بطاقات إحصائية -->
    <div class="stats-grid">
        <div class="stat-card blue">
            <h3>إجمالي الفواتير</h3>
            <div class="number" id="totalInvoices">0</div>
        </div>
        <div class="stat-card green">
            <h3>إجمالي المدفوع</h3>
            <div class="number" id="totalPaid">0</div>
        </div>
        <div class="stat-card orange">
            <h3>إجمالي المتبقي</h3>
            <div class="number" id="totalRemaining">0</div>
        </div>
        <div class="stat-card">
            <h3>عدد العملاء</h3>
            <div class="number" id="totalClients">0</div>
        </div>
    </div>

    <!-- نموذج الإضافة -->
    <div class="form-section">
        <div class="form-group">
            <label>نوع الفاتورة</label>
            <select id="invoiceType">
                <option value="purchase">مشتريات</option>
                <option value="sale">مبيعات</option>
            </select>
        </div>
        <div class="form-group">
            <label>العميل / المورد</label>
            <input type="text" id="partyName" placeholder="الاسم" value="أحمد">
        </div>
        <div class="form-group">
            <label>المبلغ الإجمالي</label>
            <input type="number" id="totalAmount" placeholder="0" value="5000">
        </div>
        <div class="form-group">
            <label>المدفوع</label>
            <input type="number" id="paidAmount" placeholder="0" value="2000">
        </div>
        <div class="form-group">
            <label>التاريخ</label>
            <input type="date" id="invoiceDate" value="2026-08-21">
        </div>
        <div class="form-group">
            <button class="btn btn-primary" onclick="addInvoice()">➕ إضافة فاتورة</button>
        </div>
    </div>

    <!-- الجدول الرئيسي -->
    <div class="table-responsive">
        <table id="invoicesTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>النوع</th>
                    <th>العميل/المورد</th>
                    <th>التاريخ</th>
                    <th>الإجمالي</th>
                    <th>المدفوع</th>
                    <th>المتبقي (أفقي)</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <!-- الصفوف تُضاف هنا بواسطة JS -->
            </tbody>
            <tfoot id="tableFooter">
                <!-- صف الإجمالي العمودي -->
            </tfoot>
        </table>
    </div>

    <!-- ملخص العملاء (المتبقي عمودي) -->
    <div style="margin-top: 30px;">
        <h3 style="color: #2d3748; margin-bottom: 15px;">📋 ملخص العملاء والموردين (المتبقي عمودياً)</h3>
        <div class="table-responsive">
            <table id="summaryTable">
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>النوع</th>
                        <th>إجمالي المشتريات/المبيعات</th>
                        <th>إجمالي المدفوع</th>
                        <th>المتبقي (عمودي)</th>
                    </tr>
                </thead>
                <tbody id="summaryBody">
                </tbody>
            </table>
        </div>
    </div>

    <div class="footer">
        نظام مشتريات ومبيعات ذكي - جميع الحقوق محفوظة © 2026
    </div>
</div>

<script>
    // ============================================
    // قاعدة بيانات مؤقتة (في الذاكرة)
    // ============================================
    let invoices = [];
    let parties = {};

    // دالة لإنشاء معرف فريد
    function generateId() {
        return Date.now() + Math.floor(Math.random() * 1000);
    }

    // إضافة فاتورة جديدة
    function addInvoice() {
        const type = document.getElementById('invoiceType').value;
        const partyName = document.getElementById('partyName').value.trim() || 'غير محدد';
        const total = parseFloat(document.getElementById('totalAmount').value) || 0;
        const paid = parseFloat(document.getElementById('paidAmount').value) || 0;
        const date = document.getElementById('invoiceDate').value || new Date().toISOString().split('T')[0];

        if (total <= 0) {
            alert('المبلغ الإجمالي يجب أن يكون أكبر من صفر');
            return;
        }
        if (paid > total) {
            alert('المدفوع لا يمكن أن يتجاوز الإجمالي');
            return;
        }

        const remaining = total - paid;
        const invoice = {
            id: generateId(),
            type: type,
            party: partyName,
            date: date,
            total: total,
            paid: paid,
            remaining: remaining
        };

        invoices.push(invoice);
        updateParties(invoice);
        renderAll();
        clearForm();
    }

    // تحديث بيانات العملاء/الموردين
    function updateParties(invoice) {
        if (!parties[invoice.party]) {
            parties[invoice.party] = {
                type: invoice.type,
                total: 0,
                paid: 0,
                remaining: 0
            };
        }
        const p = parties[invoice.party];
        p.total += invoice.total;
        p.paid += invoice.paid;
        p.remaining += invoice.remaining;
        // إذا كان نوع مختلط نضعه mixed
        if (p.type !== invoice.type) p.type = 'mixed';
    }

    // حذف فاتورة
    function deleteInvoice(id) {
        const invoice = invoices.find(inv => inv.id === id);
        if (!invoice) return;
        
        // تحديث الـ parties
        const p = parties[invoice.party];
        if (p) {
            p.total -= invoice.total;
            p.paid -= invoice.paid;
            p.remaining -= invoice.remaining;
            if (p.total === 0) delete parties[invoice.party];
        }
        
        invoices = invoices.filter(inv => inv.id !== id);
        renderAll();
    }

    // عرض جميع الجداول
    function renderAll() {
        renderInvoicesTable();
        renderSummaryTable();
        updateStats();
    }

    // عرض جدول الفواتير
    function renderInvoicesTable() {
        const tbody = document.getElementById('tableBody');
        if (invoices.length === 0) {
            tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:30px;color:#718096;">لا توجد فواتير حتى الآن</td></tr>`;
            document.getElementById('tableFooter').innerHTML = '';
            return;
        }

        let html = '';
        let totalSum = 0, paidSum = 0, remainingSum = 0;

        invoices.forEach((inv, index) => {
            totalSum += inv.total;
            paidSum += inv.paid;
            remainingSum += inv.remaining;

            const status = inv.remaining === 0 ? 'مدفوع' : (inv.paid === 0 ? 'غير مدفوع' : 'جزئي');
            const badgeClass = inv.remaining === 0 ? 'badge-paid' : (inv.paid === 0 ? 'badge-unpaid' : 'badge-partial');
            const typeLabel = inv.type === 'purchase' ? 'شراء' : 'بيع';

            html += `<tr>
                <td>${index + 1}</td>
                <td><span class="badge ${inv.type === 'purchase' ? 'badge-partial' : 'badge-paid'}">${typeLabel}</span></td>
                <td><strong>${inv.party}</strong></td>
                <td>${inv.date}</td>
                <td>${inv.total.toFixed(2)}</td>
                <td>${inv.paid.toFixed(2)}</td>
                <td><strong style="color:${inv.remaining > 0 ? '#e53e3e' : '#38a169'}">${inv.remaining.toFixed(2)}</strong></td>
                <td><span class="badge ${badgeClass}">${status}</span></td>
                <td>
                    <button class="btn btn-danger action-btn" onclick="deleteInvoice(${inv.id})">🗑</button>
                </td>
            </tr>`;
        });

        tbody.innerHTML = html;

        // صف الإجمالي (أفقي)
        const footer = document.getElementById('tableFooter');
        footer.innerHTML = `<tr class="total-row">
            <td colspan="4" style="text-align:left;">🔹 الإجمالي (أفقي)</td>
            <td>${totalSum.toFixed(2)}</td>
            <td>${paidSum.toFixed(2)}</td>
            <td style="color:#e53e3e;font-size:16px;">${remainingSum.toFixed(2)}</td>
            <td colspan="2"></td>
        </tr>`;
    }

    // عرض ملخص العملاء (عمودي)
    function renderSummaryTable() {
        const tbody = document.getElementById('summaryBody');
        const keys = Object.keys(parties);
        if (keys.length === 0) {
            tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:20px;color:#718096;">لا يوجد عملاء أو موردون</td></tr>`;
            return;
        }

        let html = '';
        let grandTotal = 0, grandPaid = 0, grandRemaining = 0;

        keys.forEach(name => {
            const p = parties[name];
            grandTotal += p.total;
            grandPaid += p.paid;
            grandRemaining += p.remaining;
            const typeLabel = p.type === 'purchase' ? 'مورد' : (p.type === 'sale' ? 'عميل' : 'مختلط');

            html += `<tr>
                <td><strong>${name}</strong></td>
                <td>${typeLabel}</td>
                <td>${p.total.toFixed(2)}</td>
                <td>${p.paid.toFixed(2)}</td>
                <td style="color:${p.remaining > 0 ? '#e53e3e' : '#38a169'};font-weight:bold;">${p.remaining.toFixed(2)}</td>
            </tr>`;
        });

        // صف الإجمالي العمودي
        html += `<tr class="summary-row">
            <td colspan="2" style="text-align:left;">🔹 الإجمالي (عمودي)</td>
            <td>${grandTotal.toFixed(2)}</td>
            <td>${grandPaid.toFixed(2)}</td>
            <td style="color:#e53e3e;font-size:16px;">${grandRemaining.toFixed(2)}</td>
        </tr>`;

        tbody.innerHTML = html;
    }

    // تحديث البطاقات الإحصائية
    function updateStats() {
        let totalInv = invoices.length;
        let totalPaid = 0, totalRemaining = 0;
        invoices.forEach(inv => {
            totalPaid += inv.paid;
            totalRemaining += inv.remaining;
        });
        document.getElementById('totalInvoices').textContent = totalInv;
        document.getElementById('totalPaid').textContent = totalPaid.toFixed(2);
        document.getElementById('totalRemaining').textContent = totalRemaining.toFixed(2);
        document.getElementById('totalClients').textContent = Object.keys(parties).length;
    }

    // مسح النموذج
    function clearForm() {
        document.getElementById('partyName').value = '';
        document.getElementById('totalAmount').value = '';
        document.getElementById('paidAmount').value = '';
        document.getElementById('invoiceDate').value = new Date().toISOString().split('T')[0];
    }

    // ============================================
    // بيانات تجريبية للبدء
    // ============================================
    function loadSampleData() {
        const sample = [
            { type: 'purchase', party: 'محمد المورد', total: 8000, paid: 3000, date: '2026-08-15' },
            { type: 'sale', party: 'أحمد العميل', total: 5000, paid: 5000, date: '2026-08-16' },
            { type: 'sale', party: 'سارة العميل', total: 3000, paid: 1000, date: '2026-08-17' },
            { type: 'purchase', party: 'خالد المورد', total: 4000, paid: 4000, date: '2026-08-18' },
            { type: 'sale', party: 'أحمد العميل', total: 2000, paid: 0, date: '2026-08-19' },
        ];
        sample.forEach(item => {
            const inv = {
                id: generateId(),
                type: item.type,
                party: item.party,
                date: item.date,
                total: item.total,
                paid: item.paid,
                remaining: item.total - item.paid
            };
            invoices.push(inv);
            updateParties(inv);
        });
        renderAll();
    }

    // تحميل البيانات عند بدء التشغيل
    loadSampleData();

    // إضافة دالة للتحكم في الإدخال بالضغط على Enter
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') {
            const active = document.activeElement;
            if (active && active.closest('.form-section')) {
                addInvoice();
            }
        }
    });
</script>
</body>
  </html>
